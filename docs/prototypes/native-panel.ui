<?xml version="1.0" encoding="UTF-8"?>
<!-- Native widget review only. No service connection or transfer action. -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="panel">
    <property name="title">rQuickShare preview</property>
    <property name="default-width">420</property>
    <property name="default-height">480</property>
    <property name="resizable">false</property>
    <property name="decorated">false</property>
    <child>
      <object class="GtkBox" id="content">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <child><object class="GtkImage"><property name="icon-name">network-wireless-symbolic</property><property name="pixel-size">28</property></object></child>
            <child><object class="GtkLabel"><property name="label">rQuickShare</property><property name="hexpand">true</property><property name="xalign">0</property><style><class name="panel-title"/></style></object></child>
            <child><object class="GtkLabel"><property name="label">Preview</property><style><class name="preview-badge"/></style></object></child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <style><class name="selection-card"/></style>
            <child><object class="GtkImage"><property name="icon-name">folder-symbolic</property><property name="pixel-size">24</property></object></child>
            <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
              <child><object class="GtkLabel"><property name="label">Files or a folder</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
              <child><object class="GtkLabel"><property name="label">Choose what you want to send</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
            </object></child>
            <child><object class="GtkButton"><property name="label">Choose</property><property name="sensitive">false</property></object></child>
          </object>
        </child>
        <child><object class="GtkStackSwitcher"><property name="stack">pages</property><property name="halign">center</property></object></child>
        <child>
          <object class="GtkStack" id="pages">
            <property name="vexpand">true</property>
            <property name="transition-type">none</property>
            <child><object class="GtkStackPage"><property name="name">nearby</property><property name="title">Nearby</property><property name="child">
              <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property>
                <child><object class="GtkLabel"><property name="label">Choose a recipient after selecting files</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
                <child><object class="GtkBox"><property name="spacing">12</property><style><class name="device-row"/></style>
                  <child><object class="GtkImage"><property name="icon-name">phone-symbolic</property><property name="pixel-size">28</property></object></child>
                  <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                    <child><object class="GtkLabel"><property name="label">Example phone</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">Nearby device</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
                  </object></child>
                  <child><object class="GtkButton"><property name="icon-name">go-next-symbolic</property><property name="sensitive">false</property><property name="tooltip-text">Choose this recipient</property></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="spacing">12</property><style><class name="device-row"/></style>
                  <child><object class="GtkImage"><property name="icon-name">computer-symbolic</property><property name="pixel-size">28</property></object></child>
                  <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                    <child><object class="GtkLabel"><property name="label">Example laptop</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">Nearby device</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
                  </object></child>
                  <child><object class="GtkButton"><property name="icon-name">go-next-symbolic</property><property name="sensitive">false</property><property name="tooltip-text">Choose this recipient</property></object></child>
                </object></child>
              </object>
            </property></object></child>
            <child><object class="GtkStackPage"><property name="name">incoming</property><property name="title">Incoming</property><property name="child">
              <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><style><class name="consent-card"/></style>
                <child><object class="GtkLabel"><property name="label">Incoming transfer</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">Waiting for sender and file details</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">Verification code</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">— — — —</property><property name="xalign">0</property><style><class name="verification-code"/></style></object></child>
                <child><object class="GtkLabel"><property name="label">Check the code on the sending device.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
                <child><object class="GtkBox"><property name="spacing">10</property><property name="halign">end</property>
                  <child><object class="GtkButton"><property name="label">Decline</property><property name="sensitive">false</property></object></child>
                  <child><object class="GtkButton"><property name="label">Accept</property><property name="sensitive">false</property><style><class name="suggested-action"/></style></object></child>
                </object></child>
              </object>
            </property></object></child>
            <child><object class="GtkStackPage"><property name="name">transfers</property><property name="title">Transfers</property><property name="child">
              <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property>
                <child><object class="GtkBox"><property name="spacing">12</property><style><class name="device-row"/></style>
                  <child><object class="GtkImage"><property name="icon-name">document-send-symbolic</property><property name="pixel-size">28</property></object></child>
                  <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                    <child><object class="GtkLabel"><property name="label">Example transfer</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">Sending files…</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
                  </object></child>
                  <child><object class="GtkButton"><property name="icon-name">process-stop-symbolic</property><property name="sensitive">false</property><property name="tooltip-text">Cancel this transfer</property></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="spacing">12</property><style><class name="device-row"/></style>
                  <child><object class="GtkImage"><property name="icon-name">emblem-ok-symbolic</property><property name="pixel-size">28</property></object></child>
                  <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                    <child><object class="GtkLabel"><property name="label">Example completed transfer</property><property name="xalign">0</property><style><class name="row-title"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">Completed</property><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
                  </object></child>
                </object></child>
              </object>
            </property></object></child>
          </object>
        </child>
        <child><object class="GtkSeparator"/></child>
        <child><object class="GtkBox"><property name="spacing">12</property>
          <child><object class="GtkLabel"><property name="label">Closing the panel keeps transfers running</property><property name="wrap">true</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="dim-label"/><class name="footer-note"/></style></object></child>
          <child><object class="GtkButton"><property name="icon-name">emblem-system-symbolic</property><property name="tooltip-text">Settings</property><property name="sensitive">false</property></object></child>
        </object></child>
      </object>
    </child>
  </object>
</interface>
