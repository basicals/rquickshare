[Desktop Entry]
Type=Service
Name=Send with rQuickShare
MimeType=application/octet-stream;inode/directory;
Actions=Send;
X-KDE-Protocols=file
X-KDE-MinNumberOfUrls=1
X-KDE-MaxNumberOfUrls=256
X-KDE-Priority=TopLevel

[Desktop Action Send]
Name=Send with rQuickShare…
Icon=document-send
Exec=rquickshare send -- %U
